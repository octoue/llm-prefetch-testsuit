#!/bin/bash
# ============================================================
# Prefetch 消融实验专用配置 — 单卡 A100 80G + Qwen3-32B
# ============================================================
# 此文件由 start_vllm_prefetch.sh 和 auto_run_prefetch_ablation.sh 加载,
# 会覆盖 system.env / experiments.env 中的同名变量。

# ========== GPU Memory (32B on single A100 80G) ==========
# Qwen3-32B BF16 权重 ~64GB, A100 80G 需要高利用率
GPU_MEMORY_UTILIZATION=0.92
# GPU 上剩余 ~8GB 给 KV cache, 每 block ~4MB → ~200 blocks (保守)
NUM_GPU_BLOCKS_OVERRIDE=200
SWAP_SPACE=256

# ========== KV Cache ==========
# GPU KV 空间有限, 加大 CPU offloading 补偿
KV_OFFLOADING_SIZE=15
VLLM_BLOCK_SIZE=16

# ========== Parallelism (单卡) ==========
VLLM_TENSOR_PARALLEL_SIZE=1

# ========== Concurrency ==========
# 降低并发防 OOM, 32B 推理本身较慢
VLLM_MAX_NUM_SEQS=24

# ========== Sequence Length ==========
# 限制最大序列长度以节省内存, pcie-heavy max_input=2200 足够
MAX_MODEL_LEN=8192

# ========== Experiment Parameters ==========
QPS=0.5
SEED=42
PREFETCH_LEAD_TIME=2.0
SCHEDULE_MODE=scaled-timestamp
TIMEOUT=600
REQUEST_TIMEOUT=360
