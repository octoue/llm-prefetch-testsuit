#!/bin/bash
# 数据集配置,添加新数据集只需在这里定义

# 数据集根目录 (相对于run-experiment目录)
DATA_ROOT=../data

# ========== Lite: 轻量测试 (原有) ==========
DATASET_LITE_TRACE="$DATA_ROOT/lite_dataset.jsonl"
DATASET_LITE_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_LITE_MAX_INPUT=1500
DATASET_LITE_NUM_CONV=18
DATASET_LITE_GPU_BLOCKS=1500  # 推荐配置

# ========== PCIe Stress: Lite ==========
DATASET_PCIE_LITE_TRACE="$DATA_ROOT/pcie_stress_lite.jsonl"
DATASET_PCIE_LITE_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_LITE_MAX_INPUT=1000
DATASET_PCIE_LITE_NUM_CONV=8
DATASET_PCIE_LITE_GPU_BLOCKS=1500

# ========== PCIe Stress: Medium (推荐) ==========
DATASET_PCIE_MEDIUM_TRACE="$DATA_ROOT/pcie_stress_medium.jsonl"
DATASET_PCIE_MEDIUM_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_MEDIUM_MAX_INPUT=1800
DATASET_PCIE_MEDIUM_NUM_CONV=12
DATASET_PCIE_MEDIUM_GPU_BLOCKS=1200

# ========== PCIe Stress: Full（完整 qwen trace，全量多轮根，不经 pcie_stress 子集采样）==========
# 与 heavy 同类的压力参数（MAX_INPUT / GPU_BLOCKS）；NUM_CONV 由 run_pcie_scheduling_ab.sh
# 对 TRACE 做行级统计（awk，与 prefetch_ab_runner 多轮根定义一致），不使用固定抽样数。
DATASET_PCIE_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_FULL_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_FULL_MAX_INPUT=2200
DATASET_PCIE_FULL_NUM_CONV=0
DATASET_PCIE_FULL_GPU_BLOCKS=1000

# ========== Trace A 分层轻量化（约 28% 行采样，保留 turn/type/timestamp/input 分布）==========
# 文件由 result-analysis/sample_trace_stratified.py 生成；NUM_CONV 由 run_pcie_scheduling_ab.sh
# 对 TRACE 统计多轮根（与 pcie-full 同逻辑），不设实验级总 timeout。
DATASET_PCIE_TRACE_A_LIGHT_TRACE="$DATA_ROOT/qwen_traceA_blksz_16_light_stratified.jsonl"
DATASET_PCIE_TRACE_A_LIGHT_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_TRACE_A_LIGHT_MAX_INPUT=2200
DATASET_PCIE_TRACE_A_LIGHT_NUM_CONV=0
DATASET_PCIE_TRACE_A_LIGHT_GPU_BLOCKS=1000

# ========== Trace A 多轮子集（all turns>=3 + 100 sampled 2-turn, seed=42）==========
# 从 light_stratified 筛选：115 个长对话(turns>=3) + 100 个随机 2-turn 对话。
# 569 请求 / 215 对话，354 个多轮请求触发 prefetch，并发可控。
# NUM_CONV=100 + MAX_OUTPUT=300: 约 267 请求，32B 模型在 QPS=1.0 下处于高压但不崩溃区间。
DATASET_PCIE_MULTITURN_TRACE="$DATA_ROOT/traceA_multiturn_medium.jsonl"
DATASET_PCIE_MULTITURN_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_MULTITURN_MAX_INPUT=2200
DATASET_PCIE_MULTITURN_NUM_CONV=100
DATASET_PCIE_MULTITURN_MAX_OUTPUT=300
DATASET_PCIE_MULTITURN_GPU_BLOCKS=1000

# ========== PCIe Stress: Heavy ==========
# 40个对话(turns 5-12), ~346请求, avg 8.7 turns, avg output 145 tokens
DATASET_PCIE_HEAVY_TRACE="$DATA_ROOT/pcie_stress_heavy.jsonl"
DATASET_PCIE_HEAVY_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_HEAVY_MAX_INPUT=2200
DATASET_PCIE_HEAVY_NUM_CONV=40
DATASET_PCIE_HEAVY_GPU_BLOCKS=1000

# ========== PCIe Stress: Heavy 8K (长上下文, heavy采样, 高缓存压力) ==========
# 60个对话(turns 3-12), 215请求, max_input=8192, 全部>5K tokens
# working set ~96K blocks, 是 GPU 容量的 96.8x
DATASET_PCIE_HEAVY_8K_TRACE="$DATA_ROOT/pcie_stress_heavy_8k.jsonl"
DATASET_PCIE_HEAVY_8K_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_HEAVY_8K_MAX_INPUT=8192
DATASET_PCIE_HEAVY_8K_NUM_CONV=60
DATASET_PCIE_HEAVY_8K_GPU_BLOCKS=1000

# ========== PCIe Stress: Heavy 8K Balanced (长上下文, 随机采样, 分布更自然) ==========
# 60个对话(turns 3-12), 255请求, max_input=8192, 长短混合
# working set ~32K blocks, 是 GPU 容量的 32.1x
DATASET_PCIE_HEAVY_8K_BALANCED_TRACE="$DATA_ROOT/pcie_stress_heavy_8k_balanced.jsonl"
DATASET_PCIE_HEAVY_8K_BALANCED_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PCIE_HEAVY_8K_BALANCED_MAX_INPUT=8192
DATASET_PCIE_HEAVY_8K_BALANCED_NUM_CONV=60
DATASET_PCIE_HEAVY_8K_BALANCED_GPU_BLOCKS=1000

# ========== PCIe Stress: Optimal (推荐用于32B) ==========
# 22个对话, 124个样本, 压力适中
DATASET_OPTIMAL_TRACE="$DATA_ROOT/pcie_stress_optimal.jsonl"
DATASET_OPTIMAL_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_OPTIMAL_MAX_INPUT=2000
DATASET_OPTIMAL_NUM_CONV=22
DATASET_OPTIMAL_GPU_BLOCKS=550  # 32B模型推荐配置

# ========== PCIe Stress: Many Short (高频Prefetch) ==========
# 25个对话, 120个样本, 对话较短但数量多
DATASET_MANY_SHORT_TRACE="$DATA_ROOT/pcie_stress_many_short.jsonl"
DATASET_MANY_SHORT_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_MANY_SHORT_MAX_INPUT=1800
DATASET_MANY_SHORT_NUM_CONV=25
DATASET_MANY_SHORT_GPU_BLOCKS=500

# ========== PCIe Stress: Balanced ==========
# 16个对话, 119个样本
DATASET_BALANCED_TRACE="$DATA_ROOT/pcie_stress_balanced.jsonl"
DATASET_BALANCED_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_BALANCED_MAX_INPUT=2300
DATASET_BALANCED_NUM_CONV=16
DATASET_BALANCED_GPU_BLOCKS=550

# ========== PCIe Stress: Extreme (激进配置) ==========
# 18个对话, 127个样本, 压力较高
DATASET_EXTREME_TRACE="$DATA_ROOT/pcie_stress_extreme.jsonl"
DATASET_EXTREME_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_EXTREME_MAX_INPUT=2500
DATASET_EXTREME_NUM_CONV=18
DATASET_EXTREME_GPU_BLOCKS=450

# ========== PCIe Stress: 32B Optimized ==========
# 20个对话, 148个样本, 专门为32B模型优化
DATASET_32B_OPTIMIZED_TRACE="$DATA_ROOT/pcie_stress_32b_optimized.jsonl"
DATASET_32B_OPTIMIZED_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_32B_OPTIMIZED_MAX_INPUT=2200
DATASET_32B_OPTIMIZED_NUM_CONV=20
DATASET_32B_OPTIMIZED_GPU_BLOCKS=500

# ========== Prefetch Ablation (80 conv, avg input 3661, high cache pressure) ==========
# 80个多轮对话(turns 3-12), 291请求, max_input=4500, heavy采样
# working set ~18K blocks, 是 GPU 容量的 17.9x
# MAX_MODEL_LEN=8192 安全 (max I+O+512=6073)
DATASET_PREFETCH_ABLATION_TRACE="$DATA_ROOT/pcie_stress_prefetch_ablation.jsonl"
DATASET_PREFETCH_ABLATION_FULL_TRACE="$DATA_ROOT/qwen_traceA_blksz_16.jsonl"
DATASET_PREFETCH_ABLATION_MAX_INPUT=4500
DATASET_PREFETCH_ABLATION_NUM_CONV=80
DATASET_PREFETCH_ABLATION_GPU_BLOCKS=1000

# ========== 数据集生成参数 ==========
DATASET_GEN_PRESET=""           # 如使用preset,设置为lite/medium/heavy
DATASET_GEN_SAMPLING_MODE=heavy # heavy或random
