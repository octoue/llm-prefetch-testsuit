#!/bin/bash
# 系统级配置,修改频率低

# ========== Model ==========
# MODEL_PATH=/lpai/models/Qwen__Qwen3-8B/25-07-26-0349
MODEL_PATH=/lpai/models/Qwen__Qwen3-32B/25-07-26-0345

# ========== GPU Memory ==========
GPU_MEMORY_UTILIZATION=0.7     # 推荐0.6-0.7
NUM_GPU_BLOCKS_OVERRIDE=550    # 根据数据集调整,0=auto
SWAP_SPACE=256

# ========== KV Cache ==========
KV_OFFLOADING_SIZE=5            # CPU offloading阈值(GB)
VLLM_BLOCK_SIZE=16

# ========== Parallelism ==========
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PIPELINE_PARALLEL_SIZE=2   # PCIe profiling需要PP=2

# ========== Concurrency ==========
VLLM_MAX_NUM_SEQS=96            # 最大并发序列数,推荐64-128

# ========== API ==========
API_PORT=8000
VLLM_HOST=0.0.0.0

# ========== Logging ==========
VLLM_LOG=vllm_state.log

# ========== Paths ==========
VLLM_SRC=../../vllm16
PCIE_PROFILER_DIR=./profiler_output
