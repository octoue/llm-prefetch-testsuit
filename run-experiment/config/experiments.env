#!/bin/bash
# 实验配置,每次实验可能调整

# ========== Request Generation ==========
QPS=1.0                         # 请求速率
SEED=42                         # 随机种子

# ========== Prefetch ==========
PREFETCH_LEAD_TIME=2.0          # prefetch提前时间(秒)
SCHEDULE_MODE=scaled-timestamp  # 调度模式

# ========== Timeouts ==========
TIMEOUT=300                     # 总实验超时(秒)
REQUEST_TIMEOUT=240             # 单个请求超时(秒)

# ========== TensorBoard ==========
TB_PORT=6007
ENABLE_TENSORBOARD=1            # 0=禁用, 1=启用

# ========== Results ==========
RESULTS_ROOT=../results
