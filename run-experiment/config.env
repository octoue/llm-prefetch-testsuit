# ============================================
# Prefetch A/B 实验配置文件（唯一参数来源）
# ============================================
# 所有参数仅在此文件定义，脚本不再有写死的默认值
# 修改此文件即可调整全部行为

# ---------- vLLM 启动 (start_vllm.sh) ----------
MODEL_PATH=/lpai/models/Qwen__Qwen3-8B/25-07-26-0349
GPU_MEMORY_UTILIZATION=0.5
NUM_GPU_BLOCKS_OVERRIDE=400
KV_OFFLOADING_SIZE=5
SWAP_SPACE=256
API_PORT=8000
VLLM_LOG=vllm_state.log
VLLM_HOST=0.0.0.0
VLLM_MAX_NUM_SEQS=256
VLLM_BLOCK_SIZE=16
VLLM_TENSOR_PARALLEL_SIZE=1

# ---------- 测试通用 ----------
API_BASE=http://localhost:8000/v1
API_HOST=localhost:8000
SEED=42

# ---------- run_ab_test.sh ----------
QPS=0.5
NUM_CONV=50
TRACE=data/qwen_traceA_blksz_16.jsonl
TIMEOUT=

# ---------- run_lite_test.sh ----------
LITE_QPS=0.2
LITE_NUM_CONV=18
LITE_TRACE=data/lite_dataset.jsonl
LITE_FULL_TRACE=data/qwen_traceA_blksz_16.jsonl
LITE_TIMEOUT=300
REQUEST_TIMEOUT=180
PREFETCH_LEAD_TIME=3.0
TB_PORT=6006

# ---------- PCIe Profiling (start_vllm_pcie.sh, run_lite_test_pcie.sh) ----------
# vLLM 源码路径，用于 setup_pcie_env.sh 和 visualize_pcie_gantt.py（相对 run-experiment 目录，code/vllm 与 code/llm-prefetch-testsuit 同级）
VLLM_SRC=../../vllm
# Profiler 输出目录（trace.json、pcie_events_*.json）
PCIE_PROFILER_DIR=./profiler_output
