# ============================================
# Prefetch A/B 实验配置文件
# ============================================
# 修改此文件后，start_vllm.sh、run_ab_test.sh、run_lite_test.sh 会自动使用新配置
# 也可通过环境变量临时覆盖，例如: QPS=0.3 ./run_ab_test.sh

# ---------- vLLM 启动配置 (start_vllm.sh) ----------
# 本地模型路径（需配合 HF_HUB_OFFLINE=1，不从 HuggingFace 下载）
MODEL_PATH=/lpai/models/Qwen__Qwen3-8B/25-07-26-0349

# GPU 显存利用率 (0~1)
GPU_MEMORY_UTILIZATION=0.5

# GPU KV blocks 数量，用于触发 offloading；设为 auto 则自动计算
NUM_GPU_BLOCKS_OVERRIDE=115

# KV Offloading 大小 (GiB)，prefetch 可从 CPU 加载 KV 到 GPU；设为 0 禁用
KV_OFFLOADING_SIZE=5

# Swap space 大小 (GiB)
SWAP_SPACE=256

# vLLM 服务端口
API_PORT=8000

# vLLM 日志文件名（相对于 run-experiment 目录）
VLLM_LOG=vllm_state.log

# ---------- 测试通用配置 (run_ab_test.sh / run_lite_test.sh) ----------
# API 地址
API_BASE=http://localhost:8000/v1
API_HOST=localhost:8000

# 随机种子
SEED=42

# ---------- run_ab_test.sh 默认参数 ----------
# 请求 QPS
QPS=0.5

# 多轮对话数量
NUM_CONV=50

# 全量 trace 文件（相对于项目根 data/）
TRACE=data/qwen_traceA_blksz_16.jsonl

# 总超时秒数（可选，不设则无限制）
# TIMEOUT=120

# ---------- run_lite_test.sh 默认参数 ----------
# 轻量测试 QPS（会覆盖上面的 QPS）
# QPS=0.8

# 轻量测试对话数
# NUM_CONV=9

# 轻量 trace（由 prepare_lite_dataset 生成，相对于项目根 data/）
# LITE_TRACE=data/lite_dataset.jsonl

# 生成 lite_dataset 的源 trace
# LITE_FULL_TRACE=data/qwen_traceA_blksz_16.jsonl

# 轻量测试总超时 (秒)
# TIMEOUT=300

# 单请求超时 (秒)
# REQUEST_TIMEOUT=120

# TensorBoard 端口
# TB_PORT=6006
