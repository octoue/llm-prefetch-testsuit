# ============================================
# Prefetch A/B 实验配置文件（唯一参数来源）
# ============================================

# ---------- API ----------
API_PORT=8000
API_HOST=localhost:${API_PORT}
API_BASE=http://${API_HOST}/v1

# ---------- vLLM 启动（start_vllm.sh / start_vllm_pcie.sh 共用）----------
MODEL_PATH=/lpai/models/Qwen__Qwen3-8B/25-07-26-0349
GPU_MEMORY_UTILIZATION=0.7
NUM_GPU_BLOCKS_OVERRIDE=700
KV_OFFLOADING_SIZE=5
SWAP_SPACE=256
VLLM_LOG=vllm_state.log
VLLM_HOST=0.0.0.0
VLLM_MAX_NUM_SEQS=256
VLLM_BLOCK_SIZE=16
VLLM_TENSOR_PARALLEL_SIZE=1

# ---------- 测试通用 ----------
SEED=42
QPS=0.6

# ---------- run_ab_test.sh ----------
NUM_CONV=50
TRACE=data/qwen_traceA_blksz_16.jsonl
TIMEOUT=

# ---------- run_lite_test.sh ----------
LITE_NUM_CONV=18
LITE_TRACE=data/lite_dataset.jsonl
LITE_TIMEOUT=300
REQUEST_TIMEOUT=240
PREFETCH_LEAD_TIME=3.0
TB_PORT=6007

# ---------- PCIe Profiling ----------
VLLM_SRC=../../vllm16
PCIE_PROFILER_DIR=./profiler_output
VLLM_PIPELINE_PARALLEL_SIZE=2

# heavy 工作负载（run_lite_test_pcie.sh 默认）
LITE_PCIE_TRACE=data/heavy_lite_4000.jsonl
LITE_PCIE_MAX_INPUT_LENGTH=4000
LITE_PCIE_TIER_SHORT=2
LITE_PCIE_TIER_MEDIUM=6
LITE_PCIE_TIER_LONG=8
LITE_PCIE_NUM_CONV=16
LITE_PCIE_SAMPLING_MODE=heavy
LITE_PCIE_SCHEDULE_MODE=scaled-timestamp
LITE_PCIE_PREFETCH_LEAD_TIME=2.0

# medium 工作负载（仅 trace 和 max_input 不同，tier/num_conv 与 heavy 共用）
LITE_PCIE_MEDIUM_TRACE=data/medium_lite_2500.jsonl
LITE_PCIE_MEDIUM_MAX_INPUT_LENGTH=2500
