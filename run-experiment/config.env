# ============================================
# Prefetch A/B 实验配置文件（唯一参数来源）
# ============================================
# 所有参数仅在此文件定义，脚本不再有写死的默认值
# 修改此文件即可调整全部行为
# 同一数值只定义一处，其余通过变量引用

# ---------- API（由 API_PORT 派生）----------
API_PORT=8000
API_HOST=localhost:${API_PORT}
API_BASE=http://${API_HOST}/v1

# ---------- vLLM 启动 (start_vllm.sh) ----------
MODEL_PATH=/lpai/models/Qwen__Qwen3-8B/25-07-26-0349
GPU_MEMORY_UTILIZATION=0.5
NUM_GPU_BLOCKS_OVERRIDE=400
KV_OFFLOADING_SIZE=5
SWAP_SPACE=256
VLLM_LOG=vllm_state.log
VLLM_HOST=0.0.0.0
VLLM_MAX_NUM_SEQS=256
VLLM_BLOCK_SIZE=16
VLLM_TENSOR_PARALLEL_SIZE=1

# ---------- 测试通用 ----------
SEED=42

# ---------- run_ab_test.sh ----------
QPS=2.0
NUM_CONV=50
TRACE=data/qwen_traceA_blksz_16.jsonl
TIMEOUT=

# ---------- run_lite_test.sh ----------
LITE_QPS=${QPS}
LITE_NUM_CONV=18
LITE_TRACE=data/lite_dataset.jsonl
LITE_FULL_TRACE=${TRACE}
LITE_TIMEOUT=300
REQUEST_TIMEOUT=240
PREFETCH_LEAD_TIME=3.0
TB_PORT=6007

# ---------- PCIe Profiling (start_vllm_pcie.sh, run_lite_test_pcie.sh) ----------
# vLLM 源码路径，用于 setup_pcie_env.sh 和 visualize_pcie_gantt.py（相对 run-experiment 目录）
VLLM_SRC=../../vllm16
PCIE_PROFILER_DIR=./profiler_output
VLLM_PIPELINE_PARALLEL_SIZE=2

# heavy-lite 工作负载（更容易打出 PCIe 竞争，可被 run_pcie_experiment_matrix 覆盖）
LITE_PCIE_TRACE=${LITE_PCIE_TRACE:-data/heavy_lite_4000.jsonl}
LITE_PCIE_SAMPLING_MODE=${LITE_PCIE_SAMPLING_MODE:-heavy}
LITE_PCIE_MAX_INPUT_LENGTH=${LITE_PCIE_MAX_INPUT_LENGTH:-4000}
# tier 档位（heavy 与 medium 共用基础值）
LITE_PCIE_TIER_SHORT=${LITE_PCIE_TIER_SHORT:-2}
LITE_PCIE_TIER_MEDIUM=${LITE_PCIE_TIER_MEDIUM:-6}
LITE_PCIE_TIER_LONG=${LITE_PCIE_TIER_LONG:-8}
LITE_PCIE_NUM_CONV=${LITE_PCIE_NUM_CONV:-16}
LITE_PCIE_SCHEDULE_MODE=${LITE_PCIE_SCHEDULE_MODE:-scaled-timestamp}
LITE_PCIE_PREFETCH_LEAD_TIME=${LITE_PCIE_PREFETCH_LEAD_TIME:-2.0}

# ---------- 中等重度 (medium) 工作负载 ----------
# max_input_length=2500，需配合 NUM_GPU_BLOCKS_OVERRIDE=600~800 启动 vLLM
# 用法: NUM_GPU_BLOCKS_OVERRIDE=700 ./start_vllm_pcie.sh 或 ./start_vllm_pcie.sh medium
LITE_PCIE_MEDIUM_TRACE=data/medium_lite_2500.jsonl
LITE_PCIE_MEDIUM_MAX_INPUT_LENGTH=2500
LITE_PCIE_MEDIUM_TIER_SHORT=${LITE_PCIE_TIER_SHORT}
LITE_PCIE_MEDIUM_TIER_MEDIUM=${LITE_PCIE_TIER_MEDIUM}
LITE_PCIE_MEDIUM_TIER_LONG=${LITE_PCIE_TIER_LONG}
LITE_PCIE_MEDIUM_NUM_CONV=${LITE_PCIE_NUM_CONV}
MEDIUM_NUM_GPU_BLOCKS_OVERRIDE=700
