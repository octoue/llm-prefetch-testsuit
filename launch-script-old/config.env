# ============================================
# vLLM CPU Offloading 测试配置文件
# ============================================

# ---------- GPU 配置 ----------
# 使用哪个 GPU (例如: 0, 1, 2,3 表示使用多卡)
CUDA_VISIBLE_DEVICES=3

# GPU 显存限制 (单位: GiB)
# 设置较小的值可以更容易触发 CPU offloading
# 例如: 8, 12, 16, 24 等
# 设置为空则不限制
GPU_MEMORY_UTILIZATION=0.5

# ---------- 模型配置 ----------
# 模型名称或路径
# 推荐使用较小的模型进行测试: Qwen/Qwen2.5-7B-Instruct, Qwen/Qwen2.5-1.5B-Instruct
MODEL_NAME="Qwen/Qwen2.5-14B-Instruct"

# ---------- KV Cache 配置 ----------
# GPU KV Cache 块数量 (设置较小值来触发 offloading)
# 例如: 100, 200, 500
# 设置为 auto 则自动计算
NUM_GPU_BLOCKS_OVERRIDE=200

# KV Cache Offloading 配置 (新版vLLM参数)
# KV offloading 缓冲区大小 (单位: GiB)
# 设置为 0 或留空则禁用 KV offloading
KV_OFFLOADING_SIZE=8

# KV offloading 后端: native (vLLM原生) 或 lmcache
KV_OFFLOADING_BACKEND="native"

# Block size (默认 16)
BLOCK_SIZE=16

# Swap space 大小 (单位: GiB, 默认 4)
SWAP_SPACE=256

# ---------- HuggingFace 配置 ----------
# 使用 HF Mirror 加速下载
HF_ENDPOINT="https://hf-mirror.com"

# HF Token (如果需要访问私有模型)
# HF_TOKEN="your_token_here"

# ---------- 服务配置 ----------
# API 服务端口
API_PORT=8000

# API 服务地址
API_HOST="0.0.0.0"

# 最大并发请求数
MAX_NUM_SEQS=256

# ---------- 日志配置 ----------
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# 是否启用详细的 offloading 日志
ENABLE_OFFLOAD_LOGGING=true

# ---------- 其他配置 ----------
# Tensor 并行度
TENSOR_PARALLEL_SIZE=1

# Pipeline 并行度  
PIPELINE_PARALLEL_SIZE=1

# 是否启用 prefix caching
ENABLE_PREFIX_CACHING=true

# Trust remote code
TRUST_REMOTE_CODE=true
